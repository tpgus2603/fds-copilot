{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tpgus2603/fds-copilot/contracts/mcp/get_transaction_history.output.schema.json",
  "title": "get_transaction_history output",
  "type": "object",
  "required": ["tool", "schema_version", "status"],
  "properties": {
    "tool": { "const": "get_transaction_history" },
    "schema_version": { "const": "1.0" },
    "status": { "enum": ["ok", "insufficient", "empty", "error"] }
  },
  "oneOf": [
    {
      "properties": { "status": { "enum": ["ok", "insufficient", "empty"] } },
      "required": ["evidence_id", "basis", "target", "stats", "category_distribution", "target_category", "recent_transactions", "quality"],
      "not": { "required": ["error"] }
    },
    {
      "properties": { "status": { "const": "error" } },
      "required": ["error"]
    }
  ],
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "empty" } } },
      "then": {
        "properties": {
          "stats": {
            "properties": {
              "txn_count": { "const": 0 },
              "amount_mean": { "type": "null" },
              "amount_median": { "type": "null" },
              "amount_p95": { "type": "null" },
              "amount_max": { "type": "null" },
              "target_to_mean_ratio": { "type": "null" },
              "target_exceeds_max": { "type": "null" }
            }
          },
          "recent_transactions": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "insufficient" } } },
      "then": { "properties": { "stats": { "properties": { "txn_count": { "minimum": 1, "maximum": 4 }, "amount_p95": { "type": "null" } } } } }
    },
    {
      "if": { "properties": { "status": { "const": "ok" } } },
      "then": { "properties": { "stats": { "properties": { "txn_count": { "minimum": 5 } } } } }
    }
  ],
  "$defs": {
    "amount": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$" },
    "nullableAmount": { "oneOf": [ { "$ref": "#/$defs/amount" }, { "type": "null" } ] },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$" },
    "transactionId": { "type": "string", "pattern": "^[A-Za-z0-9]{1,64}$" }
  },
  "patternProperties": {
    "^evidence_id$": { "type": "string", "pattern": "^EV-TH-[A-Za-z0-9]{1,64}-[0-9]{1,3}d$" },
    "^basis$": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_transaction_id", "card_token", "as_of", "window_start", "lookback_days"],
      "properties": {
        "target_transaction_id": { "$ref": "#/$defs/transactionId" },
        "card_token": { "type": "string", "pattern": "^card_[A-Za-z0-9]+$" },
        "as_of": { "$ref": "#/$defs/timestamp" },
        "window_start": { "$ref": "#/$defs/timestamp" },
        "lookback_days": { "type": "integer", "minimum": 7, "maximum": 365 }
      }
    },
    "^target$": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trans_at", "amount", "category", "merchant_name"],
      "properties": {
        "trans_at": { "$ref": "#/$defs/timestamp" },
        "amount": { "$ref": "#/$defs/amount" },
        "category": { "type": "string" },
        "merchant_name": { "type": "string" }
      }
    },
    "^stats$": {
      "type": "object",
      "additionalProperties": false,
      "required": ["txn_count", "amount_mean", "amount_median", "amount_p95", "amount_max", "target_to_mean_ratio", "target_exceeds_max"],
      "properties": {
        "txn_count": { "type": "integer", "minimum": 0 },
        "amount_mean": { "$ref": "#/$defs/nullableAmount" },
        "amount_median": { "$ref": "#/$defs/nullableAmount" },
        "amount_p95": { "$ref": "#/$defs/nullableAmount" },
        "amount_max": { "$ref": "#/$defs/nullableAmount" },
        "target_to_mean_ratio": { "type": ["number", "null"], "minimum": 0 },
        "target_exceeds_max": { "type": ["boolean", "null"] }
      }
    },
    "^category_distribution$": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "count", "share"],
        "properties": {
          "category": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 },
          "share": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "^target_category$": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seen_before", "count", "last_seen_at"],
      "properties": {
        "seen_before": { "type": "boolean" },
        "count": { "type": "integer", "minimum": 0 },
        "last_seen_at": { "oneOf": [ { "$ref": "#/$defs/timestamp" }, { "type": "null" } ] }
      }
    },
    "^recent_transactions$": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transaction_id", "trans_at", "amount", "category", "merchant_name"],
        "properties": {
          "transaction_id": { "$ref": "#/$defs/transactionId" },
          "trans_at": { "$ref": "#/$defs/timestamp" },
          "amount": { "$ref": "#/$defs/amount" },
          "category": { "type": "string" },
          "merchant_name": { "type": "string" }
        }
      }
    },
    "^quality$": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_sample_required", "notes"],
      "properties": {
        "min_sample_required": { "type": "integer", "minimum": 1 },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "^error$": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "enum": ["INVALID_ARGUMENT", "NOT_FOUND", "OUT_OF_SCOPE", "DATA_SOURCE_UNAVAILABLE", "TIMEOUT", "INTERNAL"] },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      }
    }
  },
  "additionalProperties": false
}
