{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tpgus2603/fds-copilot/contracts/mcp/compute_geo_anomaly.output.schema.json",
  "title": "compute_geo_anomaly output",
  "description": "대상 거래와 직전 거래의 가맹점 간 거리·이동 속도, 거주지와 대상 가맹점 사이 거리. 가맹점 좌표는 고객의 실측 위치가 아니며, 거주지 좌표는 결과에 포함하지 않습니다.",
  "type": "object",
  "required": [
    "tool",
    "schema_version",
    "status"
  ],
  "properties": {
    "tool": {
      "const": "compute_geo_anomaly"
    },
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "ok",
        "insufficient",
        "error"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/okResult"
    },
    {
      "$ref": "#/$defs/insufficientResult"
    },
    {
      "$ref": "#/$defs/errorResult"
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "transactionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{1,64}$"
    },
    "km": {
      "type": "number",
      "minimum": 0
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "lookback_days",
        "speed_threshold_kmh",
        "home_distance_threshold_km"
      ],
      "properties": {
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "lookback_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "speed_threshold_kmh": {
          "const": 900
        },
        "home_distance_threshold_km": {
          "const": 300
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id",
        "trans_at",
        "merchant_name",
        "home_distance_km",
        "far_from_home"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/transactionId"
        },
        "trans_at": {
          "$ref": "#/$defs/timestamp"
        },
        "merchant_name": {
          "type": "string"
        },
        "home_distance_km": {
          "oneOf": [
            {
              "$ref": "#/$defs/km"
            },
            {
              "type": "null"
            }
          ]
        },
        "far_from_home": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "home_distance_km": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "far_from_home": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "far_from_home": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    },
    "previous": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id",
        "trans_at",
        "merchant_name",
        "minutes_since",
        "distance_km",
        "speed_kmh",
        "exceeds_plausible_speed"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/transactionId"
        },
        "trans_at": {
          "$ref": "#/$defs/timestamp"
        },
        "merchant_name": {
          "type": "string"
        },
        "minutes_since": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "distance_km": {
          "$ref": "#/$defs/km"
        },
        "speed_kmh": {
          "$ref": "#/$defs/km"
        },
        "exceeds_plausible_speed": {
          "type": "boolean"
        }
      }
    },
    "successBase": {
      "required": [
        "evidence_id",
        "basis",
        "target",
        "previous"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^EV-GA-[A-Za-z0-9]{1,64}-[0-9]{1,2}d$"
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      },
      "propertyNames": {
        "enum": [
          "tool",
          "schema_version",
          "status",
          "evidence_id",
          "basis",
          "target",
          "previous"
        ]
      }
    },
    "okResult": {
      "description": "조회 기간 안에 좌표가 있는 직전 거래가 있음",
      "allOf": [
        {
          "$ref": "#/$defs/successBase"
        }
      ],
      "properties": {
        "status": {
          "const": "ok"
        },
        "previous": {
          "$ref": "#/$defs/previous"
        }
      }
    },
    "insufficientResult": {
      "description": "조회 기간 안에 직전 거래가 없거나 가맹점 좌표가 없어 이동 속도를 계산할 수 없음",
      "allOf": [
        {
          "$ref": "#/$defs/successBase"
        }
      ],
      "properties": {
        "status": {
          "const": "insufficient"
        },
        "previous": {
          "type": "null"
        }
      }
    },
    "errorResult": {
      "required": [
        "error"
      ],
      "propertyNames": {
        "enum": [
          "tool",
          "schema_version",
          "status",
          "error"
        ]
      },
      "properties": {
        "status": {
          "const": "error"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT",
            "NOT_FOUND",
            "OUT_OF_SCOPE",
            "DATA_SOURCE_UNAVAILABLE",
            "TIMEOUT",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "code": {
            "enum": [
              "DATA_SOURCE_UNAVAILABLE",
              "TIMEOUT"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "retryable": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "retryable": {
            "const": false
          }
        }
      }
    }
  }
}
