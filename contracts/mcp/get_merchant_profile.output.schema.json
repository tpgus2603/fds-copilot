{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tpgus2603/fds-copilot/contracts/mcp/get_merchant_profile.output.schema.json",
  "title": "get_merchant_profile output",
  "description": "대상 거래 가맹점의 라벨 없는 이용 집계. 가맹점 통계는 다른 카드의 거래만으로 계산하고, 다른 카드가 3장 미만이면 금액 통계를 내지 않습니다(최소 익명성). 카드 토큰과 개별 거래는 포함하지 않습니다.",
  "type": "object",
  "required": [
    "tool",
    "schema_version",
    "status"
  ],
  "properties": {
    "tool": {
      "const": "get_merchant_profile"
    },
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "ok",
        "insufficient",
        "empty",
        "error"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/okResult"
    },
    {
      "$ref": "#/$defs/insufficientResult"
    },
    {
      "$ref": "#/$defs/emptyResult"
    },
    {
      "$ref": "#/$defs/errorResult"
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "money": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "0 이상의 금액, 소수 둘째 자리 문자열 (거래 이력 툴과 같은 표현)"
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "window_start",
        "lookback_days",
        "min_sample",
        "min_cards"
      ],
      "properties": {
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "window_start": {
          "$ref": "#/$defs/timestamp"
        },
        "lookback_days": {
          "type": "integer",
          "minimum": 7,
          "maximum": 365
        },
        "min_sample": {
          "const": 5
        },
        "min_cards": {
          "const": 3
        }
      }
    },
    "merchant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merchant_name",
        "category"
      ],
      "properties": {
        "merchant_name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id",
        "amount"
      ],
      "properties": {
        "transaction_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{1,64}$"
        },
        "amount": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "merchantStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "txn_count",
        "card_count",
        "amount_mean",
        "amount_median",
        "amount_max",
        "target_to_mean_ratio",
        "target_exceeds_max"
      ],
      "properties": {
        "txn_count": {
          "type": "integer",
          "minimum": 0
        },
        "card_count": {
          "type": "integer",
          "minimum": 0
        },
        "amount_mean": {
          "oneOf": [
            {
              "$ref": "#/$defs/money"
            },
            {
              "type": "null"
            }
          ]
        },
        "amount_median": {
          "oneOf": [
            {
              "$ref": "#/$defs/money"
            },
            {
              "type": "null"
            }
          ]
        },
        "amount_max": {
          "oneOf": [
            {
              "$ref": "#/$defs/money"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_to_mean_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "target_exceeds_max": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "statsPublished": {
      "properties": {
        "txn_count": {
          "minimum": 5
        },
        "card_count": {
          "minimum": 3
        },
        "amount_mean": {
          "$ref": "#/$defs/money"
        },
        "amount_median": {
          "$ref": "#/$defs/money"
        },
        "amount_max": {
          "$ref": "#/$defs/money"
        },
        "target_exceeds_max": {
          "type": "boolean"
        }
      }
    },
    "statsSuppressed": {
      "properties": {
        "amount_mean": {
          "type": "null"
        },
        "amount_median": {
          "type": "null"
        },
        "amount_max": {
          "type": "null"
        },
        "target_to_mean_ratio": {
          "type": "null"
        },
        "target_exceeds_max": {
          "type": "null"
        }
      }
    },
    "cardAtMerchant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seen_before",
        "count",
        "last_seen_at"
      ],
      "properties": {
        "seen_before": {
          "type": "boolean"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "last_seen_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "seen_before": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "count": {
            "minimum": 1
          },
          "last_seen_at": {
            "$ref": "#/$defs/timestamp"
          }
        }
      },
      "else": {
        "properties": {
          "count": {
            "const": 0
          },
          "last_seen_at": {
            "type": "null"
          }
        }
      }
    },
    "successBase": {
      "required": [
        "evidence_id",
        "basis",
        "merchant",
        "target",
        "merchant_stats",
        "card_at_merchant"
      ],
      "propertyNames": {
        "enum": [
          "tool",
          "schema_version",
          "status",
          "evidence_id",
          "basis",
          "merchant",
          "target",
          "merchant_stats",
          "card_at_merchant"
        ]
      },
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^EV-MP-[A-Za-z0-9]{1,64}-[0-9]{1,3}d$"
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "merchant": {
          "$ref": "#/$defs/merchant"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "card_at_merchant": {
          "$ref": "#/$defs/cardAtMerchant"
        }
      }
    },
    "okResult": {
      "description": "다른 카드 거래 5건 이상, 다른 카드 3장 이상: 금액 통계 공개",
      "allOf": [
        {
          "$ref": "#/$defs/successBase"
        }
      ],
      "properties": {
        "status": {
          "const": "ok"
        },
        "merchant_stats": {
          "allOf": [
            {
              "$ref": "#/$defs/merchantStats"
            },
            {
              "$ref": "#/$defs/statsPublished"
            }
          ]
        }
      }
    },
    "insufficientResult": {
      "description": "다른 카드 거래가 있으나 5건 미만이거나 카드 3장 미만: 건수만 공개하고 금액 통계는 null",
      "allOf": [
        {
          "$ref": "#/$defs/successBase"
        }
      ],
      "properties": {
        "status": {
          "const": "insufficient"
        },
        "merchant_stats": {
          "allOf": [
            {
              "$ref": "#/$defs/merchantStats"
            },
            {
              "$ref": "#/$defs/statsSuppressed"
            },
            {
              "properties": {
                "txn_count": {
                  "minimum": 1
                }
              }
            }
          ]
        }
      }
    },
    "emptyResult": {
      "description": "기간 안에 이 가맹점의 다른 카드 거래가 없음",
      "allOf": [
        {
          "$ref": "#/$defs/successBase"
        }
      ],
      "properties": {
        "status": {
          "const": "empty"
        },
        "merchant_stats": {
          "allOf": [
            {
              "$ref": "#/$defs/merchantStats"
            },
            {
              "$ref": "#/$defs/statsSuppressed"
            },
            {
              "properties": {
                "txn_count": {
                  "const": 0
                },
                "card_count": {
                  "const": 0
                }
              }
            }
          ]
        }
      }
    },
    "errorResult": {
      "required": [
        "error"
      ],
      "propertyNames": {
        "enum": [
          "tool",
          "schema_version",
          "status",
          "error"
        ]
      },
      "properties": {
        "status": {
          "const": "error"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT",
            "NOT_FOUND",
            "OUT_OF_SCOPE",
            "DATA_SOURCE_UNAVAILABLE",
            "TIMEOUT",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "code": {
            "enum": [
              "DATA_SOURCE_UNAVAILABLE",
              "TIMEOUT"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "retryable": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "retryable": {
            "const": false
          }
        }
      }
    }
  }
}
