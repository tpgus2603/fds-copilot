{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tpgus2603/fds-copilot/contracts/agent/report.schema.json",
  "title": "investigation report (submit_report input)",
  "description": "에이전트가 submit_report 툴로 제출하는 조사 보고서. 판정이 아니라 근거와 권고입니다. 문장에는 숫자를 쓰지 않고 자리표시자로 근거를 가리킵니다. docs/04_agent_workflow.md 4절.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "findings",
    "recommendation"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "pattern": "^[^0-9{}]*$",
      "description": "아라비아 숫자와 자리표시자를 쓸 수 없습니다. 수치는 발견 사항의 자리표시자로만 표현합니다."
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "recommendation": {
      "enum": [
        "further_review_recommended",
        "no_anomaly_found",
        "insufficient_evidence"
      ]
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "statement",
        "evidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "suspicion",
            "counter",
            "gap"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "^(?:[^0-9{}]|\\{[0-9]\\})*$",
          "description": "아라비아 숫자를 쓸 수 없습니다. 수치·날짜·시각은 {0}~{9} 자리표시자로 evidence의 해당 순번을 가리키며, 서버가 렌더링합니다."
        },
        "evidence": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "suspicion",
              "counter"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "path",
        "value"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^EV-[A-Z]{2}-[A-Za-z0-9]{1,64}-[0-9]{1,3}d$"
        },
        "path": {
          "type": "string",
          "pattern": "^(/[^/]+)+$",
          "description": "JSON Pointer (RFC 6901)"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "recommendation": {
            "const": "further_review_recommended"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "properties": {
                "kind": {
                  "const": "suspicion"
                }
              },
              "required": [
                "kind"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recommendation": {
            "const": "no_anomaly_found"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "properties": {
                "kind": {
                  "const": "counter"
                }
              },
              "required": [
                "kind"
              ]
            }
          }
        }
      }
    }
  ]
}
